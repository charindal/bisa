# Copy to .env and fill in real values before running `docker compose up` on a VPS.
# Never commit the real .env file.

POSTGRES_DB=bisa_sis
POSTGRES_USER=bisa_sis
POSTGRES_PASSWORD=change-me

# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# Bootstraps the first SUPER_ADMIN account on first startup only (ignored once one exists).
SUPER_ADMIN_EMAIL=admin@example.edu
SUPER_ADMIN_PASSWORD=change-me

# Only needed if the frontend is NOT served from the same Nginx as the API
# (the default docker-compose.yml setup proxies /api through the web container, so this can stay empty).
CORS_ALLOWED_ORIGINS=

COOKIE_SECURE=true
COOKIE_SAME_SITE=Lax

# This VPS already runs other projects claiming 80, 8080 (buildtrac), 4001 (nactech),
# 4003 (tvyako), 5090 (zimdeal) — pick ports outside that set. Use different values for
# the dev vs prod .env if both ever land on the same host.
COMPOSE_PROJECT_NAME=bisa-dev
SPRING_PROFILES_ACTIVE=prod
API_PORT=8092
WEB_PORT=8094

# Only used when pulling pre-built images (CI deploys set these); `docker compose up --build`
# locally ignores them and builds from ./backend and ./frontend directly.
API_IMAGE=ghcr.io/REPLACE_WITH_GITHUB_OWNER/bisa-sis-api
WEB_IMAGE=ghcr.io/REPLACE_WITH_GITHUB_OWNER/bisa-sis-web
IMAGE_TAG=latest
